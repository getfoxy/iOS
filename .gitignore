# Xcode build products and per-machine state
build/*
DerivedData/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Xcode's own workspace scratch, which is machine-specific and noisy
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store

# Anything holding a wallet. Ecash proofs ARE the money — a backup export in
# the working directory is a bearer instrument, and committing one publishes it.
*.flashbackup
proofs*.json
backup*.json
secrets/
.env

# Design exports land here before patching; the patched Web/index.html is what
# ships, so raw exports do not need to be in history
cp-index*.html

# Generated by xcodegen from project.yml, so not in history
*.xcodeproj/
Foxy.xcodeproj.old/

# the unpacked sources — build/ is ignored above for Xcode output
!build/foxy-app.js
!build/markup.html
!build/README.md
!build/foxy-render.js
!build/app/
!build/wallet/
!build/shell/
history/

# Rebuilt by pod install and npm install, and hundreds of megabytes
Pods/
node_modules/

# Built by tools/build-iptproxy.sh; the checksums beside it are what is committed
Vendor/*.xcframework/

# built by tools/build-tor.sh; Vendor/Tor.sha256 pins it
Vendor/TorPod/tor.xcframework/

# Drafts, and source cuts of the videos: kept on disk, not in the repository.
# An editor's project file can carry its path, and so an account name, into an
# export; Web/foxy-intro.mp4 is the one that ships.
*-DRAFT.md
/*.mp4
/*.mov
/*.gif
/*.png
/*.jpg
/*.jpeg
/*.psd
/*.ai
/*.prproj

# Claude Code worktrees
.claude/

# One machine's signing team (project.yml reads FOXY_DEVELOPMENT_TEAM from it)
local.env

# Editors
.vscode/
.idea/

# Keys, certificates and signing profiles
*.pem
*.p12
*.p8
*.cer
*.key
*.mobileprovision

# Captures, crash reports, logs and test results
*.pcap
*.pcapng
*.crash
*.ips
*.xcresult
*.log

# Environment files
.env.*
*.env

# Diaries pulled off a device for debugging: they name mints and amounts
foxy-evidence/

# Words tools/smoke.py refuses that are not for publishing either
tools/smoke-private.txt
